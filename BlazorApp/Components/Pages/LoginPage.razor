@page "/login"
@using System.Net.Http.Json
@using ApiContracts
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager NavMgr

<h3>This is where you login</h3>

<label>User name:</label>
<input type="text" @bind="userName" />

<br />

<label>Password:</label>
<input type="password" @bind="password" />

@if (!string.IsNullOrEmpty(errorLabel))
{
    <p style="color: red">@errorLabel</p>
}

<br />

<button @onclick="LoginAsync">Log in</button>

@code {
    private string userName = "";
    private string password = "";
    private string errorLabel = "";

    private async Task LoginAsync()
    {
        errorLabel = "";

        try
        {
            HttpResponseMessage response = await HttpClientFactory
                .CreateClient()
                .PostAsJsonAsync(
                    NavMgr.BaseUri + "session/login",
                    new LoginRequest(userName, password));

            if (!response.IsSuccessStatusCode)
            {
                errorLabel = "Invalid username or password.";
                return;
            }

            NavMgr.NavigateTo("/", forceLoad: true);
        }
        catch (Exception e)
        {
            errorLabel = $"Error: {e.Message}";
        }
    }
}